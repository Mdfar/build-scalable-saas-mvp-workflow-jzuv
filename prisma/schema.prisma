datasource db { provider = "postgresql" url = env("DATABASE_URL") }

generator client { provider = "prisma-client-js" }

model User { id String @id @default(cuid()) email String @unique subscription String @default("free") workflows Workflow[] }

model Workflow { id String @id @default(cuid()) name String status String @default("active") userId String user User @relation(fields: [userId], references: [id]) createdAt DateTime @default(now()) }